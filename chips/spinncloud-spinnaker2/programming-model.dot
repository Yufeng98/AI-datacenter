digraph spinncloud_spinnaker2_pm {
    rankdir=TB;
    bgcolor="white";
    node [shape=box, style="rounded,filled", fontname="Helvetica", fontsize=10, margin="0.25,0.12"];
    edge [color="#888888", arrowsize=0.7];
    compound=true;
    newrank=true;
    splines=true;
    ranksep=0.5;
    nodesep=0.3;

    label="SpiNNcloud SpiNNaker2 — Programming Model: NO tensor compiler, NO device tensor type, NO kernel driver\nas_of 2026-08-08";
    labelloc="t";
    fontname="Helvetica-Bold";
    fontsize=13;

    // ===================== FRAMEWORK INTEGRATION =====================
    subgraph cluster_framework {
        label="Framework Integration";
        style="rounded,dashed";
        color="#4A90D9";
        fontcolor="#4A90D9";
        fontname="Helvetica-Bold";
        fontsize=12;
        penwidth=1.5;

        pytorch [label="PyTorch\nTraining front-end for the DNN path\nand for deep SNNs before NIR export", fillcolor="#D6E4F0"];
        snnfw [label="SNN frameworks\nsnnTorch · Norse · Sinabs · Rockpool\nNengo · Lava-DL · Spyx", fillcolor="#D6E4F0"];
        pynn [label="PyNN-INSPIRED API (not PyNN)\npy-spinnaker2 snn/\nPopulation · Projection · Network", fillcolor="#D6E4F0"];
        brian2 [label="Brian2 backend\nbrian2_sim.py\nQuantizes weights + delays\nBIT-IDENTICALLY to hardware", fillcolor="#D6E4F0"];
        absent_fw [label="ABSENT\nNo TensorFlow / JAX path\nNo vLLM · No HuggingFace serving\nNo torch.compile backend", fillcolor="#F5F5F5", color="#B71C1C", fontcolor="#B71C1C", style="rounded,filled,dashed"];
    }

    // ===================== GRAPH CAPTURE =====================
    subgraph cluster_capture {
        label="Graph Capture — import, not tracing";
        style="rounded,dashed";
        color="#00897B";
        fontcolor="#00897B";
        fontname="Helvetica-Bold";
        fontsize=12;
        penwidth=1.5;

        onnx [label="ONNX export\nThe DNN capture boundary\nNo FX / Dynamo tracing", fillcolor="#B2DFDB"];
        nir [label="NIR graph import\ns2_nir.from_nir() + ConversionConfig\nIF→lif · LIF→lif · CubaLIF→lif_curr_exp\nLinear→Projection · Conv2d→Conv2dProjection", fillcolor="#B2DFDB"];
    }

    // ===================== GRAPH COMPILER / MAPPER =====================
    subgraph cluster_compiler {
        label="Graph Compiler / Mapper — host-side Python, NO MLIR / LLVM / XLA / Triton";
        style="rounded,dashed";
        color="#7B61FF";
        fontcolor="#7B61FF";
        fontname="Helvetica-Bold";
        fontsize=12;
        penwidth=1.5;

        quark [label="AMD Quark\nINT8 power-of-two PTQ\nMSE optimization\nCross-layer equalization", fillcolor="#E4DEFF"];
        octopu [label="OctopuScheduler\nONNX → \"application graph\" IR\nLayer fusion (Linear+ReLU → 1 MLA op)\nQuantize/Dequantize folding\nAutomated tiling DSE\nLimited op coverage (list not disclosed)", fillcolor="#D1C4E9"];
        s2layer [label="S2Layer / S2Model\nTiling · PE mapping · memory allocation\nBuilds the COMPLETE DRAM image:\nglobal config │ 128-bit layer headers\nlayer params │ per-PE tile addresses", fillcolor="#D1C4E9"];
        pymap [label="py-spinnaker2 graph/ pipeline\npartitioner → placer → routing tables\nlegacy_mapping_pipeline OR\npacman_mapping_pipeline", fillcolor="#E4DEFF"];
        pacman [label="PACMAN2 (ECL-2.0)\nPartitioning And Configuration MANager\nToken-based algorithm workflow\nSpiNNaker1 lineage (inferred)", fillcolor="#E4DEFF"];
        tvm [label="MicroTVM (research stage)\nAoT to M4F + 16×4 MAC array\n\"CMSIS-NN kernels outperform\ngeneric TVM schedules\"\nCustom multi-core partitioner", fillcolor="#EDE7F6", style="rounded,filled,dashed"];
    }

    // ===================== KERNEL COMPILER / LANGUAGE =====================
    subgraph cluster_kernel {
        label="Kernel Compiler + Language — ordinary embedded ARM C";
        style="rounded,dashed";
        color="#F9A825";
        fontcolor="#F9A825";
        fontname="Helvetica-Bold";
        fontsize=12;
        penwidth=1.5;

        gcc [label="GNU Arm Embedded GCC\narm-none-eabi + custom linker scripts\n.myDataSpecSection / .myLogErrorSection\nheap+stack 4 kB at 0x1F000\nCMake snn_add_application() (v0.8.0)\nNO autotuner · NO JIT · AoT only", fillcolor="#FFF3C4"];
        cmsis [label="ARM CMSIS / CMSIS-NN\nReference CPU kernel library\nPreferred single-PE codegen target", fillcolor="#FFF3C4"];
        mllib [label="ml-lib (in gated s2-sim2lab-app)\nstruct mlacc_params\nexecute_mm() / execute_conv()\n__WFE() until MLA completion IRQ\nLocal MLA only (HW supports remote)", fillcolor="#FFE082"];
        neuronc [label="Custom neuron models — plain C\nneuron_model_impl.c (state eqs, reset)\nneuron.c (init + timestep)\nregions.h enum in lockstep with Python\nneuron_t / neuron_params_t", fillcolor="#FFE082"];
    }

    // ===================== TENSOR API =====================
    subgraph cluster_tensor {
        label="Tensor API";
        style="rounded,dashed";
        color="#34A853";
        fontcolor="#34A853";
        fontname="Helvetica-Bold";
        fontsize=12;
        penwidth=1.5;

        notensor [label="NO DEVICE TENSOR TYPE\nHost data is NumPy\nDevice data is raw memory regions\nin a statically planned map", fillcolor="#D4EDDA", color="#B71C1C", fontcolor="#B71C1C", style="rounded,filled,dashed"];
        handles [label="Hardware handles\nSpiNNaker2Chip — 148 usable cores\nSpiNNcloud48NodeBoard — 7,104 cores\n/etc/opt/spinnaker/\nspinnaker2_network_config.yml", fillcolor="#D4EDDA"];
    }

    // ===================== HOST RUNTIME =====================
    subgraph cluster_runtime {
        label="Host Runtime — userspace only";
        style="rounded,dashed";
        color="#EA4335";
        fontcolor="#EA4335";
        fontname="Helvetica-Bold";
        fontsize=12;
        penwidth=1.5;

        runner [label="ExperimentRunner (C++)\nspec.json: active_pes, mem_files,\nduration_in_s, mem_regions_to_read\n→ results.json (raw 32-bit words)", fillcolor="#F8D7DA"];
        spinnman [label="SpiNNMan2 (ECL-2.0)\nHost↔machine communication\n+ SpiNNMachine2 / SpiNNUtils2\n+ spinnaker2-stm (board STM32)", fillcolor="#F8D7DA"];
        power [label="Power runtime (v0.8.0)\nrecord_power → power.parquet + png\nlive_power browser dashboard\n0.1 s single-chip / 0.2 s 48-node", fillcolor="#F8D7DA"];
        transport [label="TRANSPORT: UDP (+UDT) over 1 GbE\nNO kernel driver · NO PCIe\nNO /dev node · NO ioctl layer\nMemory-mapped view of regs/SRAM/DRAM", fillcolor="#FFCDD2", color="#B71C1C", penwidth=2];
    }

    // ===================== ON-CHIP EXECUTION =====================
    subgraph cluster_onchip {
        label="On-chip Execution — NO operating system";
        style="rounded,filled";
        color="#1A237E";
        fontcolor="white";
        fillcolor="#1A237E";
        fontname="Helvetica-Bold";
        fontsize=12;
        penwidth=2;

        sched [label="DNN: scheduler-PE FSM\nHost raises ONE interrupt, then\nthe whole multi-layer schedule\nruns on-chip with no host interaction\n80.9–99.6 % utilization, ≈13 µs/layer", fillcolor="#283593", fontcolor="white"];
        worker [label="DNN: up to 151 worker PEs\nfetch config → DMA weights → MLA →\nDMA result → completion flag → WFI\nAsync within a layer, sync between layers", fillcolor="#283593", fontcolor="white"];
        snnloop [label="SNN: timer_callback() loop\n1 ms tick from the 1 MHz reference\nspike FIFO → synaptic ring buffer →\nneuron update → multicast emit → WFI\nNO BARRIER SYNCHRONIZATION", fillcolor="#283593", fontcolor="white"];
        scamp [label="SARK / SCAMP / Spin2API\n(spinnaker2_os — HTTP 403 gated)\nSCAMP planned for chip-global IRQ\n+ inter-board clock drift compensation", fillcolor="#283593", fontcolor="white"];
    }

    // ===================== HARDWARE =====================
    hw [label="SpiNNaker2 hardware\n152 Cortex-M4F PEs · 64 MACs each\n128 kB SRAM/PE, NO CACHE\n19.8 MB on-chip · 2 GB LPDDR4\nEvent router · 6 chip-to-chip links", shape=box, style="rounded,filled", fillcolor="#0D1440", fontcolor="white", fontname="Helvetica-Bold", penwidth=2];

    // ===================== EDGES =====================

    // Framework → capture
    pytorch -> onnx [label="export", fontsize=8];
    snnfw -> nir [label="NIR export", fontsize=8];
    pynn -> pymap [style=dashed, color="#AAAAAA"];
    nir -> pynn [label="from_nir()", fontsize=8];
    brian2 -> pynn [style=dashed, color="#AAAAAA", label="bit-accurate\nsoftware sim", fontsize=8];

    // DNN compile chain
    onnx -> quark [label="calibration set", fontsize=8];
    quark -> octopu [label="INT8 graph", fontsize=8];
    octopu -> s2layer [label="application graph", fontsize=8];
    onnx -> tvm [style=dashed, color="#AAAAAA", label="research path", fontsize=8];

    // SNN compile chain
    pymap -> pacman [style=dashed, color="#AAAAAA", label="selectable\npipeline", fontsize=8];
    pymap -> handles [style=dashed, color="#AAAAAA"];

    // Compiler → kernel
    s2layer -> gcc [style=dashed, color="#AAAAAA"];
    pymap -> gcc [label="compile-time defines\nN_NEURONS, SYNAPSE_*_BITS", fontsize=8];
    tvm -> cmsis [style=dashed, color="#AAAAAA"];
    gcc -> cmsis [style=dashed, color="#AAAAAA"];
    gcc -> mllib [style=dashed, color="#AAAAAA"];
    gcc -> neuronc [style=dashed, color="#AAAAAA"];

    // Tensor API
    handles -> notensor [style=dashed, color="#AAAAAA"];

    // → runtime
    s2layer -> runner [label="complete DRAM image", fontsize=8];
    neuronc -> runner [label="per-PE .bin", fontsize=8];
    mllib -> runner [style=dashed, color="#AAAAAA"];
    handles -> runner [style=dashed, color="#AAAAAA"];
    runner -> spinnman [style=dashed, color="#AAAAAA", label="alternate backend", fontsize=8];
    runner -> transport [label="load binaries + data", fontsize=8];
    spinnman -> transport;
    power -> transport [style=dashed, color="#AAAAAA"];

    // Runtime → on-chip
    transport -> sched [label="write DRAM,\nraise ONE interrupt", fontsize=8];
    transport -> snnloop [label="write PE memory,\nchip-global interrupt", fontsize=8];
    sched -> worker [label="layer header + IRQ", fontsize=8];
    worker -> sched [style=dashed, label="completion flag", fontsize=8];
    scamp -> snnloop [style=dashed, label="tick + drift comp", fontsize=8];

    // On-chip → hardware
    worker -> hw [color="#283593"];
    snnloop -> hw [color="#283593"];
    hw -> transport [style=dashed, color="#283593", label="results.json readout", fontsize=8];
}
