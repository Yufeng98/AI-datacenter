digraph microsoft_maia_stack {
    rankdir=TB;
    bgcolor="white";
    node [shape=box, style="rounded,filled", fontname="Helvetica", fontsize=10, margin="0.25,0.12"];
    edge [color="#888888", arrowsize=0.7];
    compound=true;
    newrank=true;
    splines=true;
    ranksep=0.5;
    nodesep=0.3;

    // ===================== FRAMEWORK INTEGRATION =====================
    subgraph cluster_framework {
        label="Framework Integration";
        style="rounded,dashed";
        color="#4A90D9";
        fontcolor="#4A90D9";
        fontname="Helvetica-Bold";
        fontsize=12;
        penwidth=1.5;
        pytorch [label="PyTorch\nFirst-class backend\nEager + graph mode\nAzure OpenAI Services", fillcolor="#D6E4F0"];
    }

    // ===================== COMPILER / IR =====================
    subgraph cluster_compiler {
        label="Compiler / IR";
        style="rounded,dashed";
        color="#7B61FF";
        fontcolor="#7B61FF";
        fontname="Helvetica-Bold";
        fontsize=12;
        penwidth=1.5;
        triton [label="Triton Compiler for Maia\nPython DSL (openai/triton)\nPortability path\nGPU + Maia cross-target", fillcolor="#E4DEFF"];
        npl [label="NPL Compiler\nNested Parallel Language\nExplicit SRAM placement\nDMA scheduling\n(not public)", fillcolor="#E4DEFF"];
    }

    // ===================== OP / KERNEL LIBRARY =====================
    subgraph cluster_oplib {
        label="Op / Kernel Library";
        style="rounded,dashed";
        color="#34A853";
        fontcolor="#34A853";
        fontname="Helvetica-Bold";
        fontsize=12;
        penwidth=1.5;
        kernels [label="Maia Kernel Library\n(not public)\nGEMM / Attention / Norm\nCollective comm kernels\nCustom NPL / Triton kernels", fillcolor="#D4EDDA"];
    }

    // ===================== RUNTIME =====================
    subgraph cluster_runtime {
        label="Runtime";
        style="rounded,dashed";
        color="#EA4335";
        fontcolor="#EA4335";
        fontname="Helvetica-Bold";
        fontsize=12;
        penwidth=1.5;
        runtime [label="Maia Runtime\n(SDK preview, not public)\nKernel dispatch + scheduling\nSRAM allocation\nDMA queue management\nHardware semaphores", fillcolor="#F8D7DA"];
    }

    // ===================== DRIVER / FIRMWARE =====================
    subgraph cluster_driver {
        label="Driver / Firmware";
        style="rounded,dashed";
        color="#757575";
        fontcolor="#757575";
        fontname="Helvetica-Bold";
        fontsize=12;
        penwidth=1.5;
        driver [label="Maia Driver\n(not public)\nPCIe BAR / cmd submission\nIRQ handling", fillcolor="#E0E0E0"];
        firmware [label="Maia Firmware\n(Azure-managed)\nFirmware-upgradeable\n'unlocks new capabilities'", fillcolor="#E0E0E0"];
    }

    // ===================== COMMUNICATION =====================
    subgraph cluster_comm {
        label="Communication";
        style="rounded,dashed";
        color="#FF6D01";
        fontcolor="#FF6D01";
        fontname="Helvetica-Bold";
        fontsize=12;
        penwidth=1.5;
        comm100 [label="Custom RoCE-like Transport (Maia 100)\nAllGather+ScatterReduce: 4800 Gbps\nAllToAll: 1200 Gbps\nAES-GCM encryption\nUnified scale-up + scale-out", fillcolor="#FFE0CC"];
        comm200 [label="On-die NIC (Maia 200)\n2.8 TB/s bidirectional\n2-tier scale-up\n6,144 accelerator clusters", fillcolor="#FFE0CC"];
    }

    // ===================== ASSEMBLER / ISA =====================
    subgraph cluster_isa {
        label="Assembler / ISA";
        style="rounded,dashed";
        color="#795548";
        fontcolor="#795548";
        fontname="Helvetica-Bold";
        fontsize=12;
        penwidth=1.5;
        isa [label="Custom Maia ISA\nVector processor: FP32 / BF16\nTensor unit: MX6 / MX9 / BF16\nFP4 / FP8 (Maia 200)\n(spec not public)", fillcolor="#EFEBE9"];
    }

    // ===================== HARDWARE =====================
    subgraph cluster_hw {
        label="Microsoft Maia Hardware (Cloud AI Accelerator)";
        style="rounded,filled";
        color="#1A237E";
        fontcolor="white";
        fillcolor="#1A237E";
        fontname="Helvetica-Bold";
        fontsize=12;
        penwidth=2;
        chip100 [label="Maia 100 (TSMC 5nm, ~820mm², ~105B transistors)\nTensor Unit (16xRx16): MX6 3POPS / BF16 0.8POPS\nVector Processor: custom ISA, FP32/BF16\n~500MB on-chip SRAM | 64GB HBM2e @ 1.8TB/s", fillcolor="#283593", fontcolor="white"];
        chip200 [label="Maia 200 (TSMC 3nm, >140B transistors)\nTile: TTU (FP4/FP8) + TVP (SIMD) + TSRAM + DMA\nCluster: tiles + CSRAM + cluster DMA\n272MB SRAM | 216GB HBM3e @ 7TB/s | 750W", fillcolor="#283593", fontcolor="white"];
        rack [label="Ares Rack (Maia 100)\n32 chips / 8 servers per rack\n~40 kW, mandatory liquid cooling\nArista+Cisco ToR switches", fillcolor="#283593", fontcolor="white"];
    }

    // ===================== EDGES =====================

    // Framework -> Compiler
    pytorch -> triton [label="graph capture\n(portability)"];
    pytorch -> npl [style=dashed, label="NPL path\n(perf)"];

    // Compiler -> Kernel
    triton -> kernels [label="compiled\nkernels"];
    npl -> kernels [label="optimized\nkernels"];

    // Compiler -> ISA
    triton -> isa [style=dashed, color="#AAAAAA"];
    npl -> isa [label="emit binary"];

    // Kernel -> Runtime
    kernels -> runtime;

    // Runtime -> Driver
    runtime -> driver;
    driver -> firmware [style=dashed];

    // ISA -> Hardware
    isa -> chip100 [label="execute"];
    isa -> chip200 [label="execute"];

    // Communication
    comm100 -> runtime [style=dashed, label="collectives"];
    comm200 -> runtime [style=dashed, label="collectives"];
    comm100 -> rack [style=dashed, color="#37474F", label="12x400GbE\nfabric"];
    comm200 -> chip200 [style=dashed, color="#283593", label="on-die NIC"];

    // Hardware relations
    chip100 -> rack [label="32 per rack"];
    firmware -> chip100 [style=dashed, color="#283593"];
    driver -> chip100 [style=dashed, color="#283593"];
    driver -> chip200 [style=dashed, color="#283593"];
}
