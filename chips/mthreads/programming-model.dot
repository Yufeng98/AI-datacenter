digraph mthreads_stack {
    rankdir=TB;
    bgcolor="white";
    node [shape=box, style="rounded,filled", fontname="Helvetica", fontsize=10, margin="0.25,0.12"];
    edge [color="#888888", arrowsize=0.7];
    compound=true;
    newrank=true;
    splines=true;
    ranksep=0.5;
    nodesep=0.3;

    // ===================== FRAMEWORK INTEGRATION =====================
    subgraph cluster_framework {
        label="Framework Integration";
        style="rounded,dashed";
        color="#4A90D9";
        fontcolor="#4A90D9";
        fontname="Helvetica-Bold";
        fontsize=12;
        penwidth=1.5;
        pytorch [label="PyTorch\ntorch.device(\"musa\")\ntorch_musa ATen dispatch\nMUSAGraph, MUSAExtension\nv2.9.1 (2026-06-29): MUSA SDK >= 5.1.0\nv2.9.0 (2026-03-17): PyTorch 2.9, SDK >= 4.3.2\nFSDP2 Context Parallel, sparse ops", fillcolor="#D6E4F0"];
        vllm [label="vLLM-MUSA\nLLM inference serving\nLLaMA/Qwen/Baichuan\nMATE tensor engine", fillcolor="#D6E4F0"];
        llamacpp [label="llama.cpp\nMUSA backend\n(PR #8383 merged)\nGGML inference", fillcolor="#D6E4F0"];
        otherfw [label="Other framework backends (2025-2026)\npaddle_musa (2025-09-10)\ntensorflow_musa_extension (2026-02-05)\nonnxruntime-musa (2026-07-27)", fillcolor="#EAF2F9", style="rounded,filled,dashed"];
    }

    // ===================== COMPILER / IR =====================
    subgraph cluster_compiler {
        label="Compiler / IR";
        style="rounded,dashed";
        color="#7B61FF";
        fontcolor="#7B61FF";
        fontname="Helvetica-Bold";
        fontsize=12;
        penwidth=1.5;
        torchcompile [label="torch.compile\nTorchInductor\n+ triton_musa", fillcolor="#E4DEFF"];
        mcc [label="MCC\nMUSA C Compiler\n(nvcc analog)\n<<<>>> kernel launch", fillcolor="#E4DEFF"];
        musify [label="Musify / CUDA ON MUSA\nAutomated CUDA→MUSA\nsource translation\nLibrary shims", fillcolor="#E4DEFF"];
        tilelang [label="TileLang MUSA\nTile-level kernel DSL\n(Triton/CUTLASS analog)\nGenerates MUSA C", fillcolor="#E4DEFF"];
        tvmmusa [label="tvm_musa (2026-01-09)\n+ tvm-ffi (2026-03-24)\nApache TVM MUSA target", fillcolor="#F0ECFF", style="rounded,filled,dashed"];
    }

    // ===================== OP LIBRARY =====================
    subgraph cluster_oplib {
        label="Op Library";
        style="rounded,dashed";
        color="#34A853";
        fontcolor="#34A853";
        fontname="Helvetica-Bold";
        fontsize=12;
        penwidth=1.5;
        mudnn [label="muDNN\n(cuDNN analog)\nConv, Attention, Norm\nFP32/BF16/FP16/INT8", fillcolor="#D4EDDA"];
        mublas [label="muBLAS\n(cuBLAS analog)\nGEMM, BLAS L1-L3\n128 TCE-optimized", fillcolor="#D4EDDA"];
        mate [label="MATE\nMUSA AI Tensor Engine\nLLM inference primitives\nmthreads-ml-py", fillcolor="#D4EDDA"];
    }

    // ===================== KERNEL LIBRARY =====================
    subgraph cluster_kernel {
        label="Kernel Library";
        style="rounded,dashed";
        color="#D4A017";
        fontcolor="#D4A017";
        fontname="Helvetica-Bold";
        fontsize=12;
        penwidth=1.5;
        muthrust [label="muThrust\n(Thrust analog)\nReduce, Scan, Sort\nParallel primitives", fillcolor="#FFF3CD"];
        mufft [label="muFFT\n(cuFFT analog)\nFast Fourier Transform", fillcolor="#FFF3CD"];
        mutlass [label="mutlass\nMUSA Templates for Linear\nAlgebra Subroutines (CUTLASS analog)\nrepo 2024-09-29; promoted to a\ntorch_musa third-party dep in v2.9.1", fillcolor="#FFF3CD"];
        tileops [label="TileOPs (2026-05-29)\nTileLang-based high-performance\nLLM operator library", fillcolor="#FFF9E6", style="rounded,filled,dashed"];
        hpcports [label="MUSA HPC / AI4Science ports\n(16 repos, 2026-06-11 → 2026-08-07)\ncp2k, LAMMPS, RELION, SU2, DeePMD-kit,\nMAGMA, AMGX, Eigen, SpFFT, Kokkos,\nflann, mahout, fused-ssim, CV-CUDA\nEnabled by PingHu native FP64", fillcolor="#FFF9E6", style="rounded,filled,dashed"];
    }

    // ===================== RUNTIME =====================
    subgraph cluster_runtime {
        label="Runtime";
        style="rounded,dashed";
        color="#EA4335";
        fontcolor="#EA4335";
        fontname="Helvetica-Bold";
        fontsize=12;
        penwidth=1.5;
        musart [label="MUSA Runtime API\nlibmusa.so\nmusaMalloc/Free/MemcpyAsync\nmusaStream, musaEvent", fillcolor="#F8D7DA"];
        musadriver [label="MUSA Driver API\nContext management\nModule loading\nFine-grained memory", fillcolor="#F8D7DA"];
        torchada [label="torchada\nCUDA→MUSA shim\n(used by vllm-musa)", fillcolor="#F8D7DA"];
    }

    // ===================== DRIVER / FIRMWARE =====================
    subgraph cluster_driver {
        label="Driver / Firmware";
        style="rounded,dashed";
        color="#757575";
        fontcolor="#757575";
        fontname="Helvetica-Bold";
        fontsize=12;
        penwidth=1.5;
        kmod [label="MUSA Kernel Driver .ko\nPCIe BAR/MMIO\nIOCTL dispatch\nDMA + interrupts", fillcolor="#E0E0E0"];
        k8splugin [label="Kubernetes Plugin\nMTT GPU resource\nHealth monitoring\nMulti-tenancy", fillcolor="#E0E0E0"];
    }

    // ===================== COMMUNICATION =====================
    subgraph cluster_comm {
        label="Communication";
        style="rounded,dashed";
        color="#FF6D01";
        fontcolor="#FF6D01";
        fontname="Helvetica-Bold";
        fontsize=12;
        penwidth=1.5;
        mccl [label="MCCL\n(NCCL analog)\nAllReduce/AllGather\n10K GPU clusters", fillcolor="#FFE0CC"];
        ompimusa [label="ompi-musa (2026-07-21)\nOpen MPI port for MUSA\n(HPC / AI4Science path)", fillcolor="#FFF0E6", style="rounded,filled,dashed"];
        mtlink [label="MTLink\nS4000: MTLink 1.0, 240 GB/s/GPU, 8 GPUs/server\nS5000: 784 GB/s card-to-card (media-reported);\ngeneration number NOT DISCLOSED\nMTT C256 supernode (announced): 128 cards/cabinet,\n256 across two cabinets, sub-microsecond latency", fillcolor="#FFE0CC"];
    }

    // ===================== ASSEMBLER / ISA =====================
    subgraph cluster_isa {
        label="Assembler / ISA";
        style="rounded,dashed";
        color="#795548";
        fontcolor="#795548";
        fontname="Helvetica-Bold";
        fontsize=12;
        penwidth=1.5;
        musaisa [label="MUSA ISA\nProprietary SIMT ISA\nWarp-based execution\nChunxiao: FP32/TF32/BF16/FP16/INT8\nPingHu (PH100): full precision FP8 → FP64\n(not publicly documented)", fillcolor="#EFEBE9"];
    }

    // ===================== HARDWARE =====================
    subgraph cluster_hw {
        label="MTT S4000 Hardware (Chunxiao die, TSMC 12nm) — with MTT S5000 (PH100 / PingHu Gen 4) overlay";
        style="rounded,filled";
        color="#1A237E";
        fontcolor="white";
        fillcolor="#1A237E";
        fontname="Helvetica-Bold";
        fontsize=12;
        penwidth=2;
        mp [label="MUSA Processors (MPs)\n4,096 SP + 128 TCE Tensor Cores\n128 FP32 + 32 INT8 + 32 SFU + 2 FP64\n28 KB local shared mem per MP", fillcolor="#283593", fontcolor="white"];
        mem [label="Memory Hierarchy\nS4000: L2 4 MB (HW-managed);\nGDDR6 48 GB, 384-bit, 768 GB/s\nS5000 (media-reported): 80 GB @ 1.6 TB/s,\ntype implied HBM, generation NOT CONFIRMED\n[Gen 5 Huashan: 8× HBM]", fillcolor="#283593", fontcolor="white"];
        interconnect [label="Interconnect\nS4000: MTLink 1.0 (240 GB/s/GPU),\n8-GPU KUAE D800 / MCCX D800\nS5000: MTT MGX (8× OAM) / MTT SGX5000\n10K GPU cluster capable\nPCIe Gen5 x16 host (S4000)", fillcolor="#283593", fontcolor="white"];
    }

    // ===================== EDGES =====================

    // Framework -> Compiler
    pytorch -> torchcompile;
    pytorch -> mcc [style=dashed, color="#AAAAAA"];
    vllm -> torchada;
    llamacpp -> mcc [style=dashed, color="#AAAAAA"];
    torchcompile -> tilelang;
    musify -> mcc [label="translates to", fontsize=8];

    // Compiler -> Op/Kernel/ISA
    mcc -> musaisa;
    tilelang -> mcc [label="generates MUSA C", fontsize=8];

    // Framework -> Op (direct dispatch)
    pytorch -> mudnn [style=dashed, color="#AAAAAA", label="ATen dispatch", fontsize=8];
    pytorch -> mublas [style=dashed, color="#AAAAAA", label="matmul", fontsize=8];
    vllm -> mate [label="MATE engine", fontsize=8];

    // Kernel -> Runtime
    muthrust -> musart;
    mufft -> musart;
    mutlass -> musart;
    tileops -> musart;
    hpcports -> musart [style=dashed, color="#AAAAAA"];
    hpcports -> ompimusa [style=dashed, color="#AAAAAA", label="MPI", fontsize=8];
    ompimusa -> mccl [style=dashed, color="#AAAAAA"];

    // New framework / compiler paths (2025-2026)
    otherfw -> mcc [style=dashed, color="#AAAAAA"];
    tvmmusa -> mcc [label="codegen", fontsize=8];
    pytorch -> mutlass [style=dashed, color="#AAAAAA", label="matmul kernels\n(torch_musa v2.9.1)", fontsize=8];

    // Op -> Runtime
    mudnn -> musart;
    mublas -> musart;
    mate -> musart;

    // Runtime chain
    musart -> musadriver;
    torchada -> musart;
    musadriver -> kmod;

    // ISA chain
    musaisa -> mp;

    // Communication
    mccl -> musart [style=dashed];
    mccl -> mtlink;
    mtlink -> interconnect [style=dashed, color="#283593"];

    // Hardware internal
    mp -> mem [color="#283593"];
    mem -> interconnect [style=dashed, color="#283593"];

    // Driver -> Hardware
    kmod -> mp [style=dashed, color="#283593"];
}
