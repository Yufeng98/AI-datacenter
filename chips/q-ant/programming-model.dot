digraph q_ant_stack {
    rankdir=TB;
    bgcolor="white";
    node [shape=box, style="rounded,filled", fontname="Helvetica", fontsize=10, margin="0.25,0.12"];
    edge [color="#888888", arrowsize=0.7];
    compound=true;
    newrank=true;
    splines=true;
    ranksep=0.5;
    nodesep=0.3;

    // ===================== FRAMEWORK INTEGRATION =====================
    subgraph cluster_framework {
        label="Framework Integration";
        style="rounded,dashed";
        color="#4A90D9";
        fontcolor="#4A90D9";
        fontname="Helvetica-Bold";
        fontsize=12;
        penwidth=1.5;
        pytorch [label="PyTorch\nOperator dispatch bridge\nCustom C++ backend", fillcolor="#D6E4F0"];
        tf [label="TensorFlow\nCustom op / plugin", fillcolor="#D6E4F0"];
        keras [label="Keras\nBackend bridge", fillcolor="#D6E4F0"];
    }

    // ===================== HIGH-LEVEL API =====================
    subgraph cluster_api {
        label="High-Level API";
        style="rounded,dashed";
        color="#7B61FF";
        fontcolor="#7B61FF";
        fontname="Helvetica-Bold";
        fontsize=12;
        penwidth=1.5;
        pyapi [label="Python API\nImperative interface\nNPS customer SDK", fillcolor="#E4DEFF"];
        cppapi [label="C / C++ API\nNative library\nPCIe data transfer", fillcolor="#E4DEFF"];
    }

    // ===================== ALGORITHM LIBRARY =====================
    subgraph cluster_qpal {
        label="Algorithm Library";
        style="rounded,dashed";
        color="#34A853";
        fontcolor="#34A853";
        fontname="Helvetica-Bold";
        fontsize=12;
        penwidth=1.5;
        qpal [label="Q.PAL\nQ.ANT Photonic Algorithm Library\nNonlinear AI primitives\nPhysics simulation ops\nComputer vision / sensor fusion", fillcolor="#D4EDDA"];
    }

    // ============ THIRD-PARTY COMPILER PATH (added 2026-08-08) ============
    subgraph cluster_thirdparty {
        label="Third-Party Compiler Path (Daisytuner, revealed Apr 2026)";
        style="rounded,dashed";
        color="#00897B";
        fontcolor="#00897B";
        fontname="Helvetica-Bold";
        fontsize=12;
        penwidth=1.5;
        daisyflow [label="Daisyflow\nPyTorch graph capture\n(no custom code)", fillcolor="#CDEDE8"];
        docc [label="docc — Daisytuner Optimizing\nCompiler Collection (SDFG-based)\nPyTorch model -> NPU Gen 2\nPublic repo; photonic backend\nNOT located in open tree", fillcolor="#CDEDE8"];
    }

    // ===================== COMPILER (INTERNAL) =====================
    subgraph cluster_compiler {
        label="Compiler (Q.ANT, Internal)";
        style="rounded,dashed";
        color="#D4A017";
        fontcolor="#D4A017";
        fontname="Helvetica-Bold";
        fontsize=12;
        penwidth=1.5;
        compiler [label="Proprietary Compiler\nMaps Q.PAL ops to\nMZI voltage tables\n(not user-facing; no ISA)", fillcolor="#FFF3CD"];
    }

    // ===================== RUNTIME / HAL =====================
    subgraph cluster_runtime {
        label="Runtime / HAL";
        style="rounded,dashed";
        color="#EA4335";
        fontcolor="#EA4335";
        fontname="Helvetica-Bold";
        fontsize=12;
        penwidth=1.5;
        runtime [label="Proprietary HAL\nPCIe DMA engine\nDAC controller\n(weight → MZI voltage)", fillcolor="#F8D7DA"];
        adc [label="Photodetector / ADC Reader\nOptical output → digital\nActivation readout", fillcolor="#F8D7DA"];
    }

    // ===================== DRIVER =====================
    subgraph cluster_driver {
        label="Driver";
        style="rounded,dashed";
        color="#757575";
        fontcolor="#757575";
        fontname="Helvetica-Bold";
        fontsize=12;
        penwidth=1.5;
        driver [label="Linux Kernel Driver\nPCIe device driver\nProprietry (closed)\nPre-installed on NPS", fillcolor="#E0E0E0"];
    }

    // ===================== HARDWARE =====================
    subgraph cluster_hw {
        label="Q.ANT Photonic NPU Hardware (LENA / NPU 2)";
        style="rounded,filled";
        color="#1A237E";
        fontcolor="white";
        fillcolor="#1A237E";
        fontname="Helvetica-Bold";
        fontsize=12;
        penwidth=2;
        mzi [label="MZI Mesh (Optical Compute)\nMach-Zehnder Interferometer array\nOptical matrix-vector multiplication\nWeights = MZI phase voltages\n(photons at ~2/3c; picosecond ops)", fillcolor="#283593", fontcolor="white"];
        tfln [label="TFLN Photonic Platform\nThin-Film LiNbO3 on Insulator, 600 nm\nPockels effect (fast phase control)\nNative chi-2 nonlinear optics (NPU 2)\nTRUMPF fab, Stuttgart", fillcolor="#283593", fontcolor="white"];
        dac [label="DAC / Input Modulator\nDigital weight → analog voltage\n→ MZI phase shift\n(weight loading via PCIe)", fillcolor="#283593", fontcolor="white"];
        nps [label="NPS Server Platform\n19-inch rack-mount; x86 host; Linux\nPCIe host interface; ~30 W chip\nMultiple NPU dies per server", fillcolor="#283593", fontcolor="white"];
    }

    // ===================== EDGES =====================

    // Framework -> API
    pytorch -> pyapi;
    tf -> pyapi [style=dashed, color="#AAAAAA"];
    keras -> pyapi [style=dashed, color="#AAAAAA"];

    // API -> Q.PAL
    pyapi -> qpal;
    cppapi -> qpal;

    // Q.PAL -> Compiler
    qpal -> compiler [label="ops", fontsize=8];

    // Third-party path: PyTorch -> Daisyflow -> docc -> hardware
    pytorch -> daisyflow [label="graph capture\n(3rd party)", fontsize=8, color="#00897B"];
    daisyflow -> docc [color="#00897B"];
    docc -> runtime [label="Faster R-CNN / ResNet-50\ndemonstrated on NPU Gen 2;\ndelivery mechanism not disclosed", fontsize=8, style=dashed, color="#00897B"];

    // Compiler -> Runtime
    compiler -> runtime [label="voltage tables", fontsize=8];

    // Runtime -> Driver
    runtime -> driver;
    adc -> runtime [label="result tensors", fontsize=8, style=dashed];

    // Driver -> Hardware
    driver -> dac [label="weight config\n(PCIe DMA)", fontsize=8];
    driver -> nps;

    // Hardware internal
    dac -> mzi [label="phase voltages\n(weights)", fontsize=8, color="#283593"];
    mzi -> tfln [color="#283593"];
    mzi -> adc [label="photodetectors\n→ ADC", fontsize=8, color="#283593"];
    tfln -> mzi [style=dashed, color="#283593", label="material platform", fontsize=8];
    nps -> mzi [style=dashed, color="#283593"];
}
