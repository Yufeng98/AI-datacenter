digraph tesla_dojo_hw {
    rankdir=TB;
    bgcolor="white";
    node [shape=box, style="rounded,filled", fontname="Helvetica", fontsize=10, margin="0.25,0.12"];
    edge [color="#555555", arrowsize=0.7];
    compound=true;
    newrank=true;
    ranksep=0.5;
    nodesep=0.4;

    // ===================== COMPUTE ENGINE =====================
    subgraph cluster_compute {
        label="Compute Engine";
        style="rounded,dashed";
        color="#D32F2F";
        fontcolor="#D32F2F";
        fontname="Helvetica-Bold";
        fontsize=12;
        penwidth=1.5;

        node_unit [label="Training Node (×354 per D1)\n64-byte SIMD vector unit\n64-bit scalar control unit\nBF16 / CFP8 / CFloat16 / FP32\n2 GHz clock", fillcolor="#FFCDD2"];
        d1_perf [label="D1 Chip Performance\n376 TFLOPS BF16/CFP8\n22 TFLOPS FP32\nTSMC 7nm | 645mm² | 50B transistors\n400 W TDP", fillcolor="#FFCDD2"];
    }

    // ===================== DATA PATH =====================
    subgraph cluster_datapath {
        label="Data Path";
        style="rounded,dashed";
        color="#E65100";
        fontcolor="#E65100";
        fontname="Helvetica-Bold";
        fontsize=12;
        penwidth=1.5;

        mesh [label="On-chip 2D Mesh\n354-node network\n~10 TB/s directional BW\nSoftware-scheduled routing\nNo hardware coherence", fillcolor="#FFE0B2"];
        c2c [label="Chip-to-Chip SerDes\n576 lanes per D1 at 112 GT/s\n~8 TB/s aggregate C2C\nDirect butt-join (no switch silicon)\n96 bi-directional links", fillcolor="#FFE0B2"];
    }

    // ===================== ON-CHIP MEMORY =====================
    subgraph cluster_onchip {
        label="On-chip Memory";
        style="rounded,dashed";
        color="#1565C0";
        fontcolor="#1565C0";
        fontname="Helvetica-Bold";
        fontsize=12;
        penwidth=1.5;

        sram [label="Distributed SRAM Scratchpad\n440 MB total per D1 chip\n1.25 MB per training node\nLoad: ~400 GB/s per node\nStore: ~270 GB/s per node\nSoftware-managed (no cache)", fillcolor="#BBDEFB"];
    }

    // ===================== OFF-CHIP MEMORY =====================
    subgraph cluster_offchip {
        label="Off-chip Memory (via DIP Cards)";
        style="rounded,dashed";
        color="#2E7D32";
        fontcolor="#2E7D32";
        fontname="Helvetica-Bold";
        fontsize=12;
        penwidth=1.5;

        hbm [label="HBM (Dojo Interface Processor Cards)\n5 DIP cards per tile edge\n~13 TB/s aggregate per tile\nExaPOD total: ~13 TB\n(Not on D1 die; separate daughter cards)", fillcolor="#C8E6C9"];
        host_link [label="Host Server Link\n~160 GB/s per tile edge\nVideo data ingestion via TTP\nFrom host DRAM to DIP cards", fillcolor="#C8E6C9"];
    }

    // ===================== HOST INTERFACE / PACKAGE =====================
    subgraph cluster_host {
        label="Host Interface / Package";
        style="rounded,dashed";
        color="#6A1B9A";
        fontcolor="#6A1B9A";
        fontname="Helvetica-Bold";
        fontsize=12;
        penwidth=1.5;

        tile_pkg [label="Training Tile PCB\n25 D1 chips (5×5 direct-mount)\n~15 kW TDP\n9 PFLOPS BF16 | 11 GB SRAM\nSubstrate is the interconnect", fillcolor="#E1BEE7"];
    }

    // ===================== SCALE-UP INTERCONNECT =====================
    subgraph cluster_scaleup {
        label="Scale-up Interconnect (On-tile Mesh)";
        style="rounded,dashed";
        color="#00695C";
        fontcolor="#00695C";
        fontname="Helvetica-Bold";
        fontsize=12;
        penwidth=1.5;

        tile_mesh [label="Training Tile Mesh\n25 D1 chips direct-connected\n36 TB/s aggregate tile BW\nNo switching silicon\n5×5 direct SerDes grid", fillcolor="#B2DFDB"];
        cabinet [label="Cabinet / ExaPOD Hierarchy\nSystem Tray: 6 tiles\nCabinet: 2 trays (300 D1 chips)\nExaPOD: 10 cabinets (3000 D1 chips)\n1 EFLOPS BF16 | 1.3TB SRAM + 13TB HBM", fillcolor="#B2DFDB"];
    }

    // ===================== SCALE-OUT INTERCONNECT =====================
    subgraph cluster_scaleout {
        label="Scale-out Interconnect (TTPoE)";
        style="rounded,dashed";
        color="#37474F";
        fontcolor="#37474F";
        fontname="Helvetica-Bold";
        fontsize=12;
        penwidth=1.5;

        ttpoe [label="TTPoE (Tesla Transport Protocol over Ethernet)\nLossy Ethernet fabric (no PFC needed)\nMicrosecond-range latency\nHardware-offloaded Dumb-NIC\nOpen-sourced at HC2024", fillcolor="#CFD8DC"];
        eth_switch [label="Commodity Ethernet Switches\nNo InfiniBand / RoCEv2 / PFC\nTesla joined UltraEthernet Consortium\nOnly open-source Dojo artifact", fillcolor="#CFD8DC"];
    }

    // ===================== EDGES =====================

    // Compute -> Data Path
    node_unit -> mesh [label="node\ncommunication"];
    d1_perf -> c2c [style=dashed, label="chip\nboundary"];

    // Data Path -> On-chip Memory
    mesh -> sram [label="explicit DMA\n(compiler-scheduled)"];

    // On-chip -> Off-chip Memory
    sram -> hbm [label="DMA via\nDIP cards", style=dashed];
    host_link -> hbm [label="TTP\ningestion"];

    // Off-chip -> Host Interface / Package
    hbm -> tile_pkg [style=dashed, label="DIP card\nattached"];

    // Package -> Scale-up
    tile_pkg -> tile_mesh [label="25 chips\ntile"];
    c2c -> tile_mesh [label="SerDes\nlinks"];

    // Scale-up hierarchy
    tile_mesh -> cabinet [label="tiles →\ncabinets →\nExaPOD"];

    // Scale-out
    cabinet -> ttpoe [label="inter-ExaPOD"];
    ttpoe -> eth_switch [label="fabric"];
}
