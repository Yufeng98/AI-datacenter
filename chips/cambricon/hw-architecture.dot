digraph cambricon_hw {
    rankdir=TB;
    bgcolor="white";
    node [shape=box, style="rounded,filled", fontname="Helvetica", fontsize=10, margin="0.25,0.12"];
    edge [color="#555555", arrowsize=0.7];
    compound=true;
    newrank=true;
    ranksep=0.5;
    nodesep=0.4;

    // ===================== COMPUTE ENGINE =====================
    subgraph cluster_compute {
        label="Compute Engine";
        style="rounded,dashed";
        color="#D32F2F";
        fontcolor="#D32F2F";
        fontname="Helvetica-Bold";
        fontsize=12;
        penwidth=1.5;

        core [label="MLU Core (IPU Core)\nFunctional Unit (FU)\nScalar / Vector / Matrix / Tensor ops\n64 × 32-bit GPRs (control+addressing)", fillcolor="#FFCDD2"];
        cluster [label="Cluster\n4 MLU Cores + Memory Core DMA\n+ Shared SRAM\n__sync_cluster() barrier", fillcolor="#FFCDD2"];
        count [label="Core Count by Product\nMLU220: 1 cluster / 4 cores\nMLU270: 4 clusters / 16 cores\nMLU290: 8 clusters / 32 cores\nMLU370 (Siyuan 370): ~32+ cores\nMLU590 (Siyuan 590): ~64+ cores", fillcolor="#FFCDD2"];
    }

    // ===================== DATA PATH =====================
    subgraph cluster_datapath {
        label="Data Path";
        style="rounded,dashed";
        color="#E65100";
        fontcolor="#E65100";
        fontname="Helvetica-Bold";
        fontsize=12;
        penwidth=1.5;

        spmd [label="SPMD Execution Model\nAll Cores run same BANG C kernel\nIndependent instruction streams\nNo SIMT warp concept", fillcolor="#FFE0B2"];
        dma [label="Memory Core DMA Engine\n(per-cluster, runs independently)\nAsync GDRAM ↔ Shared SRAM\nEnable double-buffering overlap", fillcolor="#FFE0B2"];
        mlisa [label="MLISA ISA\n64-bit load-store instructions\nScalar / Vector / Matrix / Control\nNo vector register file\n(operands in NRAM/WRAM)", fillcolor="#FFE0B2"];
    }

    // ===================== ON-CHIP MEMORY =====================
    subgraph cluster_onchip {
        label="On-chip Memory";
        style="rounded,dashed";
        color="#1565C0";
        fontcolor="#1565C0";
        fontname="Helvetica-Bold";
        fontsize=12;
        penwidth=1.5;

        nram [label="NRAM (Neural-RAM)\nPer-core private scratchpad\nVector/tensor activation data\nExplicitly DMA-managed (__nram__)", fillcolor="#BBDEFB"];
        wram [label="WRAM (Weight-RAM)\nPer-core private scratchpad\nConvolution kernel weights\nFeeds matrix FU directly (__wram__)", fillcolor="#BBDEFB"];
        shared_sram [label="Shared SRAM\nPer-cluster (4 Cores share)\nData staging buffer\nInter-core exchange (__mlu_shared__)", fillcolor="#BBDEFB"];
        llc [label="LLC\nHardware-managed (read-only)\nShared weight broadcast\nOn GDRAM access path", fillcolor="#BBDEFB"];
    }

    // ===================== OFF-CHIP MEMORY =====================
    subgraph cluster_offchip {
        label="Off-chip Memory (GDRAM)";
        style="rounded,dashed";
        color="#2E7D32";
        fontcolor="#2E7D32";
        fontname="Helvetica-Bold";
        fontsize=12;
        penwidth=1.5;

        lpddr5 [label="LPDDR5 (MLU370-X8)\n48 GB / 614.4 GB/s (dual-chip)\nChina's first LPDDR5 cloud AI chip\n3× prev-gen bandwidth", fillcolor="#C8E6C9"];
        hbm [label="HBM2 (MLU290-M5)\n32 GB / 1,228 GB/s\n512 INT8 TOPS\n64 FP32 TFLOPS", fillcolor="#C8E6C9"];
        hbm_future [label="HBM (MLU590)\nGeneration TBD\nSupply-constrained (export ctrl)\nHigher BW for LLM training", fillcolor="#C8E6C9"];
    }

    // ===================== HOST INTERFACE / PACKAGE =====================
    subgraph cluster_host {
        label="Host Interface / Package";
        style="rounded,dashed";
        color="#6A1B9A";
        fontcolor="#6A1B9A";
        fontname="Helvetica-Bold";
        fontsize=12;
        penwidth=1.5;

        pcie [label="PCIe Gen4 x16\n~64 GB/s bidir\nMLU370-M8 / MLU370-X / MLU290\nFHFL card form factor", fillcolor="#E1BEE7"];
        pkg [label="Package\nMonolithic die (current)\nFHFL PCIe card\nChiplet design (research: arXiv 2409.15654)", fillcolor="#E1BEE7"];
    }

    // ===================== SCALE-UP INTERCONNECT =====================
    subgraph cluster_scaleup {
        label="Scale-up Interconnect";
        style="rounded,dashed";
        color="#00695C";
        fontcolor="#00695C";
        fontname="Helvetica-Bold";
        fontsize=12;
        penwidth=1.5;

        mlulink [label="MLU-Link\nCambricon chip-to-chip interconnect\nDual Siyuan 370 on MLU370-X8\n48 GB unified LPDDR5 pool", fillcolor="#B2DFDB"];
        multicard [label="8-Card Scale-up\nServer backplane MLU-Link\n~155% of 350W RTX GPU\n(BERT/YOLO/ResNet benchmark)\nNo external switch ASIC disclosed", fillcolor="#B2DFDB"];
    }

    // ===================== SCALE-OUT INTERCONNECT =====================
    subgraph cluster_scaleout {
        label="Scale-out Interconnect";
        style="rounded,dashed";
        color="#37474F";
        fontcolor="#37474F";
        fontname="Helvetica-Bold";
        fontsize=12;
        penwidth=1.5;

        cncl [label="CNCL\nAllReduce/AllGather\nReduceScatter/Broadcast\nOver MLU-Link (intra-node)", fillcolor="#CFD8DC"];
        eth_ib [label="Standard Ethernet / IB\nStandard NICs for inter-node\nNo proprietary scale-out NIC\nGloo for heterogeneous clusters", fillcolor="#CFD8DC"];
    }

    // ===================== EDGES =====================

    // Compute -> Data Path
    core -> spmd [label="executes"];
    cluster -> dma [label="Memory Core\nruns DMA"];

    // Data Path -> On-chip Memory
    spmd -> nram [label="R/W\noperands"];
    spmd -> wram [label="read\nweights"];
    dma -> shared_sram [label="async\nfill"];
    shared_sram -> nram [label="Core\nload"];

    // On-chip -> Off-chip Memory
    nram -> llc [label="DMA miss\n(read-only)"];
    llc -> lpddr5 [label="GDRAM\naccess"];
    llc -> hbm [label="GDRAM\naccess"];

    // Off-chip -> Host Interface
    lpddr5 -> pcie [style=dashed, label="host\nDMA"];
    hbm -> pcie [style=dashed, label="host\nDMA"];

    // Host Interface -> Scale-up
    pcie -> mlulink [style=invis]; // layout
    pkg -> pcie [style=dashed];

    // Scale-up internal
    mlulink -> multicard [label="8-card\nfabric"];

    // Scale-up -> Scale-out
    multicard -> eth_ib [label="inter-node", style=dashed];
    cncl -> mlulink [label="collectives\nover MLU-Link"];
    eth_ib -> cncl [style=dashed, label="EFA/IB\nfallback"];

    // Cross-references
    hbm_future -> hbm [style=dashed, label="next-gen\nsuccesor", color="#2E7D32"];
}
